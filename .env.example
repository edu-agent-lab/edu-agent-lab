# 저장소 루트에 .env 하나만 둔다. 앱마다 두면 같은 키를 여러 벌 관리해야 한다.
#
#   cp .env.example .env   후 값을 채운다
#
# 모든 앱이 이 파일을 읽는다 (각 앱의 코드에서 parents[2] / ".env").

# --- Notion (apps/notion-search) ---------------------------------------
# 팀 Integration Secret. 워크스페이스 소유자가 발급해 공유. ntn_ 으로 시작
# https://www.notion.so/profile/integrations 에서 발급하고 대상 페이지에
# Connections로 연결해야 검색·조회가 된다
NOTION_TOKEN=

# apps/topic-retrieval chat.py의 'Notion에 저장' 위치. 비우면 '실전 프로젝트 2' 페이지 아래.
# integration이 그 페이지에 Connections로 연결돼 있어야 한다
NOTION_PARENT_PAGE_ID=

# --- LLM (apps/notion-search 요약·분류, apps/topic-retrieval 자료 생성) ---
# platform.openai.com에서 발급, sk- 로 시작
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- 임베딩 (apps/topic-retrieval) --------------------------------------
# 로컬 모델이라 API 키가 필요 없다. 다른 모델을 쓰고 싶을 때만 채운다
# (허깅페이스 repo id). 비우면 dragonkue/BGE-m3-ko
EMBEDDING_MODEL=
